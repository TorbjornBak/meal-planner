# --- Database ---
# Compose sets this for the app container; override for local dev.
DATABASE_URL="postgresql://mealplanner:mealplanner@localhost:5432/mealplanner?schema=public"

# --- Accounts (§9) ---
# Secret used to sign session-adjacent tokens (the bookmarklet capture token
# and the newsletter unsubscribe links). Changing it invalidates those links.
# Passwords are scrypt-hashed in the database and don't depend on it.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Email (§9, §9b) ---
# Your own SMTP server — used for password resets, household invitations, and
# the weekly digest. Leave SMTP_HOST unset to run without email: the app works,
# but nobody can reset a forgotten password or be invited.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
# "true" for implicit TLS (port 465). Port 587 negotiates STARTTLS instead.
SMTP_SECURE=false
# Omit both if your relay doesn't require authentication.
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MealPlanner <mealplanner@example.com>"

# Set to "false" only for a self-hosted mail server with a self-signed
# certificate, on a network you trust. Certificates are verified otherwise.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# If your mail server runs on the *host*, "localhost" here means the app
# container, not the box — point this at the host's address instead.

# Absolute base URL used for links in email — reset links, the weekly digest,
# unsubscribe. Emails are read away from the app, so it can't be inferred.
# On a tailnet this is the MagicDNS name (§10).
APP_URL="https://box.your-tailnet.ts.net"

# --- Weekly newsletter (§9b) ---
# The app schedules the digest itself — there is no crontab to keep in step.
# The send hour is a wall clock in DIGEST_TIMEZONE, so it doesn't drift when the
# clocks change. Day is MON-SUN, hour is 0-23.
DIGEST_SEND_DAY=FRI
DIGEST_SEND_HOUR=17
DIGEST_TIMEZONE="Europe/Copenhagen"
# "off" stops the app sending the digest at all. In development it stays idle
# unless set to "on", so a laptop pointed at real data can't mail the household.
DIGEST_SCHEDULER=on

# Bearer token for POST /api/newsletter/send, which is now only for sending by
# hand — re-running one week with ?weekStart=YYYY-MM-DD, say. Leave it unset and
# the endpoint refuses; the scheduled send is unaffected either way.
#
#   curl -sS -X POST -H "Authorization: Bearer <the value below>" \
#     https://box.your-tailnet.ts.net/api/newsletter/send
#
CRON_SECRET="change-me-to-a-long-random-string"

# --- Postgres container (docker-compose) ---
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=mealplanner
POSTGRES_DB=mealplanner
