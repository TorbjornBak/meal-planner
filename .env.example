# --- Database ---
# Compose sets this for the app container; override for local dev. The
# mealplanner/mealplanner credentials below are a LOCAL-DEV DEFAULT, not a
# real password — fine on a laptop against the loopback-only Postgres this
# repo's docker-compose.yml starts, wrong the moment anything is reachable
# from outside your own machine. In production (NODE_ENV=production), the app
# refuses to start if DATABASE_URL still carries them — see POSTGRES_USER /
# POSTGRES_PASSWORD near the bottom of this file, which is what actually sets
# this in a Compose deployment.
DATABASE_URL="postgresql://mealplanner:mealplanner@localhost:5432/mealplanner?schema=public"

# --- Accounts (§9) ---
# Secret used to sign session-adjacent tokens (the bookmarklet capture token
# and the newsletter unsubscribe links). Changing it invalidates those links.
# Passwords are scrypt-hashed in the database and don't depend on it.
#
# REQUIRED in production. The app refuses to start (src/lib/startupConfig.ts)
# if this is unset, shorter than 20 characters, or still the placeholder value
# below — that placeholder is public in this repository, so leaving it in
# place is worse than leaving the variable unset. Generate a real one with:
#
#   openssl rand -base64 32
#
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Email (§9, §9b) ---
# Your own SMTP server — used for password resets, household invitations, and
# the weekly digest. Leave SMTP_HOST unset to run without email: the app works,
# but nobody can reset a forgotten password or be invited.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
# "true" for implicit TLS (port 465). Port 587 negotiates STARTTLS instead.
SMTP_SECURE=false
# Omit both if your relay doesn't require authentication.
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MealPlanner <mealplanner@example.com>"

# Set to "false" only for a self-hosted mail server with a self-signed
# certificate, on a network you trust. Certificates are verified otherwise.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# If your mail server runs on the *host*, "localhost" here means the app
# container, not the box — point this at the host's address instead.

# Absolute base URL used for links in email — reset links, the weekly digest,
# unsubscribe. Emails are read away from the app, so it can't be inferred.
# This is the public hostname served by the deployment's HTTPS terminator (§10).
#
# REQUIRED in production, must be replaced (the value below is only an
# example), and must be https. The links this URL builds
# carry one-time tokens (a password reset, an invitation, an unsubscribe) that
# are as good as a password while they're live, and the security headers only
# send HSTS when this is https. The app refuses to start otherwise
# (src/lib/startupConfig.ts).
APP_URL="https://mealplanner.example.com"

# --- Weekly newsletter (§9b) ---
# The app schedules the digest itself — there is no crontab to keep in step.
# The send hour is a wall clock in DIGEST_TIMEZONE, so it doesn't drift when the
# clocks change. Day is MON-SUN, hour is 0-23.
DIGEST_SEND_DAY=FRI
DIGEST_SEND_HOUR=17
DIGEST_TIMEZONE="Europe/Copenhagen"
# "off" stops the app sending the digest at all. In development it stays idle
# unless set to "on", so a laptop pointed at real data can't mail the household.
DIGEST_SCHEDULER=on

# Bearer token for POST /api/newsletter/send, which is now only for sending by
# hand — re-running one week with ?weekStart=YYYY-MM-DD, say. Leave it unset and
# the endpoint refuses; the scheduled send is unaffected either way. Also
# authenticates POST /api/backup/run — see the backups section below.
#
#   curl -sS -X POST -H "Authorization: Bearer <the value below>" \
#     https://mealplanner.example.com/api/newsletter/send
#
# REQUIRED in production. The placeholder is public in this repository, so
# replace it with a real secret (`openssl rand -base64 32`). Production refuses
# to start when this is missing, weak, or unchanged (src/lib/startupConfig.ts).
CRON_SECRET="change-me-to-a-long-random-string"

# --- Backups (§11) ---
# The app takes a Borg backup of the database every night and shows you, on the
# settings screen, whether it worked. All of this is OPTIONAL: leave BORG_REPO
# unset and the box runs without backups — the scheduler idles and says so.
# Setting BORG_REPO turns backups on, and then BORG_PASSPHRASE is required.
#
# Anywhere reachable over SSH with borg installed will do. A Hetzner Storage
# Box is the cheap one — note the port (23, not 22) and the /./ in the path,
# which means "relative to the login's home directory":
BORG_REPO="ssh://u123456@u123456.your-storagebox.de:23/./mealplanner"

# Encrypts the repository, and is the ONLY thing that can decrypt it.
#
# Write it down somewhere that is not this box — a password manager, or paper.
# If the box is lost and this passphrase with it, the backups are unreadable
# and there is nothing anybody can do about that. It is deliberately not stored
# in the database, since the database is the thing it would be needed to
# restore. The settings screen can generate one for you.
#
# This placeholder is public in the repository. Production refuses to start if
# BORG_REPO is set and this passphrase is missing, unchanged, or shorter than
# 20 characters (src/lib/startupConfig.ts) — an archive encrypted with a
# passphrase anyone can read is no better than an unencrypted one. With
# BORG_REPO unset none of this applies and nothing is backed up.
BORG_PASSPHRASE="change-me-to-a-long-random-string"

# When the nightly backup runs. A wall clock in BACKUP_TIMEZONE, so it doesn't
# drift when the clocks change. If the box is off at this hour, the backup
# happens as soon as it comes back — nothing is silently skipped.
BACKUP_HOUR=3
BACKUP_TIMEZONE="Europe/Copenhagen"

# "off" stops the app backing up on its own; the button on the settings screen
# still works. In development it stays idle unless set to "on", so a laptop
# pointed at a copy of real data can't write archives into the household's
# repository.
BACKUP_SCHEDULER=on

# How many archives to keep. On a deduplicated repository these cost little
# more than the newest one.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Where the SSH key the app generates and borg's deduplication cache live.
# Defaults suit the container; both are on a named volume so they survive a
# rebuild (see docker-compose.yml). Change only if you mount them elsewhere.
# BACKUP_STATE_DIR=/var/lib/mealplanner

# CRON_SECRET above also authenticates POST /api/backup/run, for anyone who
# would rather drive backups from the host than let the app schedule them:
#
#   curl -sS -X POST -H "Authorization: Bearer <CRON_SECRET>" \
#     https://mealplanner.example.com/api/backup/run
#

# --- Postgres container (docker-compose) ---
# docker-compose.yml uses these to start the db container AND to assemble the
# app container's DATABASE_URL — see its `app.environment` block. Change both
# together; the app never sees POSTGRES_USER/POSTGRES_PASSWORD directly; it
# only ever sees the DATABASE_URL compose built from them. The values below
# are docker-compose.yml's own fallback defaults, restated here so `.env` is
# the one place documenting them — they are fine for a laptop, and the same
# thing the startup check above refuses to boot with in production.
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=mealplanner
POSTGRES_DB=mealplanner
