// MealPlanner v1 data model — see DESIGN.md §"Data model sketch".
//
// One household, one shared plan/library/ledger. Individual accounts exist for
// sign-in and for addressing email, not for isolating data (§9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Recipe library (§1, §2)
// -----------------------------------------------------------------------------

/// What a recipe *is*, which decides where it lives and what can be done with
/// it (§2c).
///
/// A drink is a recipe in every way that matters — it is pasted and parsed the
/// same way, it has ingredients, a method with timers, a photo — but it is not
/// dinner. The plan is dinners only (§3), so a morning cortado has no night to
/// sit on, and leaving drinks in the same list meant scrolling past six coffees
/// to find the ragù. A dessert is the same argument: a pavlova belongs in the
/// library and not on Tuesday.
///
/// One question with one answer, which is why these are values here rather than
/// columns of their own. A recipe that is both a dinner and a dessert is not
/// something the library needs to represent.
///
/// SIDE is the exception that proves what the column is for: it is not a
/// dinner, but it *does* go on a night — the salad is cooked on Thursday next
/// to the roast and bought for with it — so unlike a drink or a dessert it
/// reaches the plan and the shopping list (§5). The column records what a
/// recipe is; what follows from that is isPlannable / isSuggestable in
/// src/lib/recipeKind.ts.
///
/// An enum rather than a reserved tag string: `tags` is free text the household
/// types, so "drink", "Drink" and "drinks" would all mean this and none of them
/// could be relied on by the plan picker, which has to be *sure* a recipe is
/// plannable before offering it.
enum RecipeKind {
  DINNER
  SIDE
  DRINK
  DESSERT
}

/// What a recipe is *made of*, at the level a household decides on (§2d).
///
/// One axis — what sits at the centre of the plate — and one value per recipe,
/// because that is the shape of the question being asked. "We had fish on
/// Monday" rules out a night; it does not rule out an ingredient.
///
/// An enum for the reason `RecipeKind` is one, only more so: the dashboard's
/// suggestions (§2e) offer a recipe *as* vegetarian, and a filter reading free
/// text will eventually put a ragù in front of someone who asked for none.
///
/// MEAT covers poultry — a household planning a week thinks "meat or fish or
/// neither", and splitting the chicken out would make the commonest category
/// two clicks. FISH covers shellfish, for the same reason. Adding a value is a
/// value here, a value in `RECIPE_CATEGORIES`, and a migration; the words the
/// UI needs all hang off that list (src/lib/recipeCategory.ts).
enum RecipeCategory {
  MEAT
  FISH
  VEGETARIAN
  VEGAN
}

/// Everything pasted-and-parsed is saved here and accumulates into the library.
model Recipe {
  id                  String           @id @default(cuid())
  name                String
  /// Dinner, side, drink or dessert (§2c). Defaults to DINNER so every recipe
  /// that existed before the sections did stays where its household left it.
  kind                RecipeKind       @default(DINNER)
  /// What it's made of (§2d) — the filter behind "what shall we have?".
  ///
  /// Nullable on purpose, and nothing was backfilled. Every recipe that
  /// predates the question has no honest answer to it: reading the ingredient
  /// lines would find "kylling" inside "kyllingebouillon" and file a soup as
  /// meat, or miss the fish sauce and call a curry vegan. An invented dietary
  /// claim is worse than an absent one, so null means "nobody has said" and is
  /// shown that way — never as "vegetarian" by omission.
  category            RecipeCategory?
  /// Where it came from (URL or free text). Optional — pasted plans may lack one.
  source              String?
  /// The method/steps text, captured at parse time for the cooking view (§2).
  instructions        String?
  /// Raw captured page HTML (bookmarklet capture), kept so a recipe can be
  /// re-parsed later without re-fetching. Null for hand-pasted recipes.
  sourceHtml          String?
  /// Servings the recipe is written for; scaling divides by this. (§4)
  statedServings      Int
  /// Roughly how long the whole dish takes, in minutes — the field that answers
  /// "what's quick on a Tuesday". Filled from the source page's schema.org
  /// `totalTime` (or `prepTime` + `cookTime`) at import, otherwise estimated
  /// from the step timers, and editable by hand like every other parsed field
  /// (§1). Null when we have neither and nobody has typed one.
  totalTimeMinutes    Int?
  /// Whether `totalTimeMinutes` is a guess of ours rather than a number the
  /// recipe stated. Adding up the step timers overstates a dish — steps overlap
  /// and resting counts as cooking — so a summed time is shown as "about 40
  /// min" while a declared one is shown flat. The flag has to be stored, not
  /// recomputed at render, because the sum's inputs (the method text) can be
  /// edited away while the number stays. Typing a time by hand clears it: a
  /// human who wrote a number meant it.
  totalTimeIsEstimate Boolean          @default(false)
  /// Where the photo came from — the source page's og:image / JSON-LD image.
  /// Kept for provenance and as a fallback when we hold no bytes of our own.
  imageUrl            String?
  /// The recipe photo itself, stored in the database like receipt photos (§7)
  /// so the app stays self-contained and works offline over Tailscale.
  image               Bytes?
  imageMime           String?
  isFavorite          Boolean          @default(false)
  tags                String[]         @default([])
  ingredients         IngredientLine[]
  dinnerSlots         DinnerSlot[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([isFavorite])
  @@index([kind])
  @@index([category])
}

/// One "name / quantity / unit" line belonging to a recipe. Corrected by the
/// mandatory review-and-edit step before it counts toward anything (§1).
model IngredientLine {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  /// Null for "to taste" / uncountable lines. Weight/volume scale precisely;
  /// countable items round up to whole units at list-generation time (§4).
  quantity Float?
  /// e.g. "g", "ml", "clove", or null for bare counts ("2 onions").
  unit     String?
  /// Preserves the order lines were parsed/entered in.
  position Int     @default(0)

  @@index([recipeId])
}

// -----------------------------------------------------------------------------
// Weekly dinner plan (§3, §4)
// -----------------------------------------------------------------------------

/// A single week of dinners. A night may hold several dinners or none at all
/// (leftovers / eating out).
model WeekPlan {
  id           String        @id @default(cuid())
  /// The Monday of the week (date-only), unique per household.
  weekStart    DateTime      @unique @db.Date
  slots        DinnerSlot[]
  /// The nights that were decided *not* to need a dinner (§3, §9b).
  nightNotes   NightNote[]
  shoppingList ShoppingList?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// One dinner assigned to a night. A night can hold several (§3); an empty
/// night simply has no slots. Removing a recipe from the library removes it
/// from every night it was on (cascade).
model DinnerSlot {
  id               String   @id @default(cuid())
  weekPlanId       String
  weekPlan         WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  /// 0 = Monday … 6 = Sunday.
  dayOfWeek        Int
  recipeId         String
  recipe           Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Per-dinner override of household size for guests / batch-cooking (§4).
  servingsOverride Int?
  /// Orders the dinners within a single night.
  position         Int      @default(0)

  @@index([weekPlanId, dayOfWeek])
  @@index([recipeId])
}

/// Why a night has no dinner on it (§3).
///
/// Three cases cover what a household actually says out loud, and OTHER with
/// free text catches the rest rather than inviting a longer enum.
enum NightNoteKind {
  LEFTOVERS
  OUT
  OTHER
}

/// A night that was *decided* to need no dinner, rather than one nobody has got
/// to yet (§3, §9b).
///
/// §3 has always allowed an empty night ("leftovers / eating out") but the plan
/// couldn't tell that from a gap, so the weekly digest counted both and nagged
/// "Fill in the 4 empty nights" at a household that eats leftovers every
/// Wednesday — precisely the every-week nothing-to-say mail §9b exists to
/// avoid. A note is the household saying "that one's settled".
///
/// Why a separate table rather than making DinnerSlot.recipeId nullable, which
/// is the shorter-looking change: a null-recipe slot would leak into
/// aggregateShoppingList (§5), the digest and the plan page, all of which read
/// `slot.recipe` and assume a dinner is there. Their TypeScript types say
/// `recipe: X | null`, but the schema has never permitted it since §3's
/// multiple-dinners migration made recipeId required, so that null branch has
/// never once run — turning it on would be turning on untested code in the
/// three places a wrong answer is most expensive. A table of its own leaves
/// every one of them alone: a note has no ingredients, so nothing to buy.
model NightNote {
  id         String        @id @default(cuid())
  weekPlanId String
  weekPlan   WeekPlan      @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  /// 0 = Monday … 6 = Sunday, matching DinnerSlot.dayOfWeek.
  dayOfWeek  Int
  kind       NightNoteKind
  /// What it actually is, when the kind alone doesn't say — "Mormors fødselsdag",
  /// "the lasagne from Sunday". Optional: most nights need no explaining.
  text       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  /// One decision per night. Unlike a dinner, a note doesn't stack — deciding
  /// twice is changing your mind, which is an upsert, not a second row. Doubles
  /// as the lookup index for reading a week's notes.
  @@unique([weekPlanId, dayOfWeek])
}

// -----------------------------------------------------------------------------
// Shopping list (§5, §6)
// -----------------------------------------------------------------------------

/// A persistent list derived from a WeekPlan, keyed by ingredient identity so
/// it can be re-diffed against plan changes without losing checked state (§5).
model ShoppingList {
  id          String             @id @default(cuid())
  weekPlanId  String             @unique
  weekPlan    WeekPlan           @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  items       ShoppingListItem[]
  generatedAt DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// One actionable line on the list. Surviving items keep `checked` across
/// re-generation; new ingredients arrive unchecked, removed ones drop off.
model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  /// Normalized ingredient-name key used for merge + diff identity (§5).
  ingredientKey  String
  /// Human-readable name shown in the UI.
  displayName    String
  /// Aggregated primary amount (may be null for "to taste").
  quantity       Float?
  unit           String?
  /// When units don't reconcile cleanly we show both rather than guess (§5),
  /// e.g. "2 onions" + "150 g onion". Null when a single clean amount exists.
  altQuantity    Float?
  altUnit        String?
  /// Ticked-off state, shared across household phones (§6).
  checked        Boolean      @default(false)
  /// Pulled into the "Pantry — check you have these" section (§5).
  isPantry       Boolean      @default(false)
  /// Typed onto the list by hand rather than derived from a planned dinner —
  /// kitchen roll, nappies, the milk nobody cooks with. Regeneration rebuilds
  /// the derived lines from scratch (§5); this flag marks the rows it must
  /// carry across untouched instead. It's also what makes a line deletable:
  /// removing a derived one would be a lie, since it comes straight back on
  /// the next generation.
  isManual       Boolean      @default(false)

  @@unique([shoppingListId, ingredientKey])
  @@index([shoppingListId])
}

/// The household's "things we always have" list. Matched by name against the
/// shopping list to move items into the pantry section (§5).
model PantryItem {
  id        String   @id @default(cuid())
  name      String
  /// Normalized key matched against ShoppingListItem.ingredientKey.
  nameKey   String   @unique
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Spending (§7, §8)
// -----------------------------------------------------------------------------

/// One grocery trip. Loosely coupled to the shopping list — no item-level
/// cost attribution (§7).
model ShoppingTrip {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  store     String
  /// The typed-in receipt total.
  total     Decimal  @db.Money
  receipt   Receipt?
  createdAt DateTime @default(now())

  @@index([date])
}

/// The receipt photo for a trip, stored in the database (§7). No OCR.
model Receipt {
  id         String       @id @default(cuid())
  tripId     String       @unique
  trip       ShoppingTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  photo      Bytes
  mimeType   String
  uploadedAt DateTime     @default(now())
}

// -----------------------------------------------------------------------------
// Accounts (§9)
// -----------------------------------------------------------------------------

/// One household member. Accounts exist so sign-in can be revoked per person
/// and so email has somewhere to go — *not* to isolate data. Every member sees
/// the same plan, library and ledger.
model User {
  id              String           @id @default(cuid())
  /// Lowercased at write time; the login identifier.
  email           String           @unique
  /// Display name for greetings in email. Optional — email alone is enough.
  name            String?
  /// Scrypt hash (see src/lib/password.ts). Null between being invited and
  /// choosing a password, which is why invited members can't yet sign in.
  passwordHash    String?
  /// Weekly digest opt-in (§9b). One-click unsubscribe flips this to false.
  newsletterOptIn Boolean          @default(true)
  sessions        Session[]
  authTokens      AuthToken[]
  newsletters     NewsletterSend[]
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// A signed-in browser. Server-side so signing out (or removing a member)
/// takes effect immediately, unlike a self-contained signed cookie.
model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the cookie's random token. The raw token is never stored, so
  /// a database leak doesn't hand over live sessions.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Refreshed lazily so an active session slides forward rather than expiring
  /// mid-shop.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// What a one-time emailed link is for. Password reset and invitation are the
/// same mechanism pointed at different copy; MAGIC_LINK is here so passwordless
/// sign-in can be added without a migration.
enum AuthTokenPurpose {
  PASSWORD_RESET
  INVITE
  MAGIC_LINK
}

/// A single-use, expiring token delivered by email. Stored hashed for the same
/// reason sessions are.
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  expiresAt DateTime
  /// Set the moment it's redeemed; a redeemed token is dead even if the link
  /// is opened again from the recipient's mail history.
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One digest delivered to one member for one week. The unique constraint is
/// the idempotency guard: a cron that fires twice can't send twice (§9b).
model NewsletterSend {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The Monday of the week the digest looks ahead to (date-only).
  weekStart DateTime @db.Date
  sentAt    DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([weekStart])
}

// -----------------------------------------------------------------------------
// Backups (§11)
// -----------------------------------------------------------------------------

/// What set a backup going: the app's own schedule, or somebody pressing the
/// button on the settings screen.
enum BackupTrigger {
  SCHEDULED
  MANUAL
}

/// One attempt at a backup — successful or not (§11).
///
/// Recorded for two reasons, and the second is the important one.
///
/// The scheduler compares `day` against the day the schedule says is owed,
/// which is what turns a fifteen-minute tick into one backup a night rather
/// than ninety. Failures are rows too, so a run that failed at three is
/// retried at quarter past rather than written off until tomorrow.
///
/// And a household can *see* it. The specific way backups fail is silently:
/// the archives stop and everything looks exactly as it did, until the day
/// somebody needs one. A visible "backed up 6 hours ago" — or "last succeeded
/// nine days ago" — is the difference between finding that out on a Tuesday
/// and finding it out on the worst day of the year.
///
/// Deliberately no unique constraint on `day`: a household may back up by hand
/// as often as it likes, and the scheduled run's idempotence comes from asking
/// whether the owed day already has a successful row.
model BackupRun {
  id              String        @id @default(cuid())
  /// The local calendar day (in BACKUP_TIMEZONE) this run satisfies.
  day             DateTime      @db.Date
  trigger         BackupTrigger @default(SCHEDULED)
  startedAt       DateTime      @default(now())
  /// Null while a run is in flight — and left null forever if the box was
  /// rebooted mid-backup, which is how such a row is recognised later.
  finishedAt      DateTime?
  ok              Boolean       @default(false)
  /// Archive name in the repository — what a restore passes to `borg extract`.
  archive         String?
  /// Sizes as borg reported them: the dump, its compressed form, and what this
  /// archive actually added to the repository. BigInt because a household's
  /// receipt photos will outgrow a 32-bit count of bytes long before anything
  /// else here matters.
  originalBytes   BigInt?
  compressedBytes BigInt?
  dedupedBytes    BigInt?
  /// The diagnosis for a failed run, already redacted of the passphrase.
  error           String?
  /// Complaints from a run that did produce an archive — a prune that couldn't
  /// get the lock, say. The backup is safe; something still wants reading.
  warnings        String?

  @@index([day])
  @@index([startedAt])
}

// -----------------------------------------------------------------------------
// Settings (§4, §9) — single household-wide row.
// -----------------------------------------------------------------------------

model Settings {
  /// Singleton row; always id = 1.
  id            Int      @id @default(1)
  /// Default servings every recipe scales to (§4).
  householdSize Int      @default(2)
  updatedAt     DateTime @updatedAt
}
